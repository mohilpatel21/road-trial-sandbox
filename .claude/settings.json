{
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Edit(/build/seals/**)",
      "Edit(**/google-services.json)",
      "Read(**/*.keystore)", "Edit(**/*.keystore)",
      "Read(**/*.jks)", "Edit(**/*.jks)",
      "Read(**/key.properties)", "Edit(**/key.properties)",
      "Read(**/.env*)", "Edit(**/.env*)",
      "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)", "Bash(git clean *)", "Bash(rm -rf *)",
      "Bash(gh pr merge *)", "Bash(flutter clean *)",
      "mcp__github__merge_pull_request"
    ],
    "ask": [
      "Bash(firebase deploy *)",
      "Bash(flutter pub add *)", "Bash(flutter pub upgrade *)"
    ],
    "allow": [
      "Bash(flutter analyze *)", "Bash(flutter test *)", "Bash(flutter run *)",
      "Bash(flutter build *)", "Bash(flutter pub get)",
      "Bash(dart format *)", "Bash(dart run *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git status)",
      "Bash(git diff *)", "Bash(git log *)",
      "Bash(git push origin *)", "Bash(git stash list)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command",
        "command": "bash \"${CLAUDE_PROJECT_DIR}/tool/road/session_start.sh\"" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command",
          "command": "bash \"${CLAUDE_PROJECT_DIR}/tool/road/guard.sh\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command",
          "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format_dart.sh\"", "async": true } ] }
    ]
  }
}
